    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Agent Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"sarah@gmail.com\",\n  \"password\": \"Test@12345\"\n}"},
            "url": {"raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const tokens = res.data?.tokens || res.tokens || res;",
                  "if (tokens.access) pm.collectionVariables.set('access_token', tokens.access);",
                  "if (tokens.refresh) pm.collectionVariables.set('refresh_token', tokens.refresh);",
                  "pm.test('Agent login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@carwash.app\",\n  \"password\": \"admin123\"\n}"},
            "url": {"raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const tokens = res.data?.tokens || res.tokens || res;",
                  "if (tokens.access) pm.collectionVariables.set('access_token', tokens.access);",
                  "if (tokens.refresh) pm.collectionVariables.set('refresh_token', tokens.refresh);",
                  "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"},
            "url": {"raw": "{{base_url}}/api/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api", "auth", "token", "refresh", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) pm.collectionVariables.set('access_token', res.access);",
